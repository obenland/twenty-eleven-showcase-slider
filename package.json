{
	"name": "twenty-eleven-showcase-slider",
	"version": "3.0.0",
	"private": true,
	"description": "Adds carousel functionality to the Twenty Eleven Showcase template.",
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@wordpress/env": "^11.6.0",
		"@wordpress/scripts": "^32.3.0",
		"terser": "^5.48.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"format": "wp-scripts format",
		"build": "terser js/twenty-eleven-showcase-slider.js --compress --mangle --comments false --output js/twenty-eleven-showcase-slider.min.js",
		"start": "wp-env start",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:install": "playwright install --with-deps chromium"
	}
}
